# Python
__pycache__/
*.py[cod]
*$py.class

# Virtual environments
venv/
# Owner 2026-10-13: .env IS tracked on purpose. The repo is private, and scp-ing
# the env to the VPS on every setup is a waste; it comes from the repo instead.
# Same posture as `tywala/server`, which already tracks .env and master-key.txt
# (§13 items 25, 64). Rotation stays owed on principle: CSFLE_MASTER_KEY,
# JWT_SECRET, the Atlas URI and the Gmail app password all enter git history.
# Local backups stay out -- noise, not config.
#.env
#.env.*
.env.bak.*
.env.*.bak
env.secrets

mongodb_crypt/

# Owner 2026-10-13: every .md is ignored EXCEPT docs/, which is now tracked.
# Before this, `git status` never showed a doc edit and a new doc needed
# `git add -f` or it was silently lost.
*.md
#!docs/*.md
#!docs/**/*.md
*.zip
gitKeys.txt
graphify-out/

# Node
node_modules/

# Model artifacts (large files)
trained_models/*.pkl
backend/ml/trained_models/*.pkl

# EMG service data files
emg-service/*.bin
emg-service/*.md
emg-service/.claude
emg-service/history.json
emg-service/data/*.bin

# Old physio reference (temp, delete after Group E)
backend/_old_physio_reference/__pycache__/
backend/_old_physio_reference/.git/
backend/_old_physio_reference/.claude/
backend/_old_physio_reference/graphify-out/
backend/_old_physio_reference/*.md
backend/_old_physio_reference/.gitignore
backend/_old_physio_reference/.graphifyignore

.graphifyignore

# IDE
.vscode/
.idea/
*.swp
*.swo

# OS
.DS_Store
Thumbs.db

# Additional model and data artifacts
*.joblib
*.mov
*.parquet
*.pkl
# Structured logs (§8b.7 — may contain landmark DEBUG data; patient biometric)
backend/logs/
*.log

# Session evidence -- landmark coordinates are biometric data (§8b.7) and the
# retention policy (§8: delete only after confirmed report save) cannot be
# honoured by anything that reaches git history. Same reasoning as backend/logs/.
backend/app/session_data/

# Phase J React toolchain (~80MB)
frontend/app/node_modules/
frontend/dist/

# CSFLE local master key -- never commit (G2-A finding)
master-key.txt

# Vendor CSFLE shared library (~103MB extracted). Downloaded, not source --
# see docs/09g_g2_0_resolutions.md for the fetch step.
mongo_crypt_shared_v1-*/
mongo_crypt_shared_v1-*.tgz

# Local static-server scratch dir
frontend/.serve/

# DB_MIGRATION_PLAN Phase 0 dumps: real patient PHI (ciphertext + metadata).
# Never commit.
part2/temp/

# CSFLE master key lives in the root .env as CSFLE_MASTER_KEY, never in the repo.
part2/Hemophillia-confirm/backend/master-key.txt

# Per-host crypt_shared library: x86-64 on the laptop, aarch64 9.0.2 on the ARM
# VPS, both at the SAME path so the tracked .env works on either. Never committed:
# an 80-97 MB binary of one arch in git becomes the other host's boot failure.
mongodb_crypt/lib/
mongodb_crypt/*.tgz

data/
emg-service/data/
.gitignore2
dev
**/*test*
**/*tests*
**/*scripts*
scripts/
frontend/tools/
