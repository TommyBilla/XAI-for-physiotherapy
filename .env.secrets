# ── SECRETS ──────────────────────────────────────────────────
# Split out of .env so key material lives in one file with one owner.
# Loaded ALONGSIDE .env, never instead of it: docker-compose lists both,
# and config/secrets.js loads both.
#
# Nothing here has a fallback anywhere in the code. A missing value is a
# startup failure, deliberately -- a fallback JWT secret means tokens that
# validate under a value an attacker can read in the repo, and a fallback
# encryption key means PHI written in cleartext.
#
# chmod 600. Never committed. Never printed.

JWT_SECRET=ef26ac4972ee4c690d2c16eaea7ba98fe8216f6c71f87f196d784b041627dddc13827676af1b8ba0e566d9b8a25a7b83b751a792cb7fb3e50546ec951c9819b4
CSFLE_MASTER_KEY=RG/Tg7VPXgI0R/p+NHHzkRaS/eBQjWoV151v3sUxuNc+IizRgi9lvaMg+EOZU2EQnLcL7CpQF6synuuZWmMqIR+LDWKXTO57ddWv83BMniyXtE9j2111nvf0MoNJUZ+n

# CSFLE data encryption key _id (UUID, base64, 16 bytes).
# This is an IDENTIFIER, not key material -- it names which DEK in
# encryption.__keyVault to use. The DEK's bytes live in Atlas, wrapped by
# CSFLE_MASTER_KEY above. It is here because config must not carry constants
# that differ between environments, not because it is secret.
CSFLE_DATA_KEY_ID=cK8aqOqVSBCJKGnAHZMimw==
